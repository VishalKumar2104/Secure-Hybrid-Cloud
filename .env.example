# ==============================================================================
# SERNMS Environment Configuration Template
# Copy this file to .env before starting production or Docker deployment
# ==============================================================================

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Used when profile is set to 'mysql')
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sernms_db
DB_USERNAME=sernms_user
DB_PASSWORD=SecureDbPass123!
DB_ROOT_PASSWORD=RootSecurePass2026!

# JWT Token Security (Must be at least 256 bits for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AWS Cloud Integration (dual-mode: 'simulated' for offline zero-cost dev, 'live' for real AWS credentials)
AWS_MODE=simulated
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
